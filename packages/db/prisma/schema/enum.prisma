enum Gender {
  male
  female
}

/// What a Source is. Shown lowercase in the UI.
enum SourceKind {
  BOOK
  PAPER
  MANUSCRIPT
  LECTURE
  TALK
  POST
}

/// Canonical: by a known external author, needs a source and verification.
/// Original: declared by a member as their own. Private: the owner's only,
/// never public, never in the dataset.
enum QuoteType {
  CANONICAL
  ORIGINAL
  PRIVATE
}

/// One status per quote, covering both lifecycle tracks, their outcomes and
/// private quotes. The allowed moves live in apps/api/src/quotes/lifecycle.ts.
enum QuoteStatus {
  // a private quote
  PRIVATE
  // both tracks
  SUBMITTED
  CURATION_REVIEW
  CURATED
  DATASET_RELEASE
  // canonical track
  UNDER_REVIEW
  VERIFIED
  // original track
  ORIGINALITY_CHECK
  PUBLISHED
  COMMUNITY_DISCOVERY
  CURATION_CANDIDATE
  // outcomes
  NEEDS_EVIDENCE
  DISPUTED
  REJECTED
  WITHDRAWN
}

/// What a report says is wrong (the report dialog's choices).
enum ReportReason {
  ATTRIBUTION
  CONTENT
  ORIGINALITY
  DUPLICATE
  OTHER
}

/// Where a report is. How it ended is its ReviewDecision.
enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  /// The quote is marked disputed while the report is investigated.
  DISPUTED
  RESOLVED
}

enum ReviewKind {
  VERIFICATION
  MODERATION
  CURATION
}

/// A reviewer's decision. Which kind allows which is in
/// apps/api/src/review/decisions.ts.
enum ReviewOutcome {
  // verification
  VERIFY
  NEEDS_EVIDENCE
  REJECT
  // curation
  CURATE
  KEEP_OUT
  // moderation
  PUBLISH
  MARK_DISPUTED
  WITHDRAW
}

/// How a possible match was found. It flags for review; it never decides
/// authorship.
enum MatchMethod {
  /// Identical after normalising case, punctuation and whitespace.
  EXACT
  FUZZY
  /// Same attributed author and close wording.
  AUTHOR
}
