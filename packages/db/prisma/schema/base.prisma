// Datasource + generators. The models live in the other files in this folder.
//
// The client is generated as CommonJS and compiled to dist/ by `yarn build`, so
// the API (CJS) and the worker (ESM) both import the same build of it:
// `import { PrismaClient } from '@qotm/db/client'`.

datasource db {
  provider   = "postgresql"
  // Trigram similarity for the live match and the originality check (QOT-34).
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client"
  output          = "../generated"
  moduleFormat    = "cjs"
  previewFeatures = ["views", "fullTextSearchPostgres", "postgresqlExtensions"]
}

generator dbml {
  provider            = "prisma-dbml-generator"
  output              = "../"
  projectName         = "Qotm"
  projectDatabaseType = "PostgreSQL"
}
