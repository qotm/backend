{
	// Compiles the generated client to CommonJS. No "type": "module" in
	// package.json, so node16 resolution emits CJS that ESM can import too.
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"target": "ES2022",
		"rootDir": "./prisma/generated",
		"outDir": "./dist",
		"declaration": true,
		"sourceMap": false,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": ["node"]
	},
	"include": ["prisma/generated"]
}
