# Copy to .env.test. Every test script is wrapped in `dotenv -e .env.test --`,
# so this file — not .env — is what the suite runs against. Point it at the
# test Docker stack (compose.test.yml), never at your dev database: the e2e
# factory truncates every table between specs.

APP_ENV='test'
APP_NAME='Qotm Api Test'
APP_HOST='0.0.0.0'
PORT='5001'
SERVER_HOST='http://localhost:5001'
FRONTEND_HOST='http://localhost:3000'
MISC_CORS_ORIGINS=''

DATABASE_URL='postgresql://root:postgres@localhost:5499/main'

BETTER_AUTH_SECRET='test-secret-not-used-in-production'
BETTER_AUTH_URL='http://localhost:5001'
BETTER_AUTH_COOKIE_DOMAIN='.lvh.me'
BETTER_AUTH_COOKIE_PREFIX='qotm-api-test'
AUTH_PASSWORD_ENABLED='true'

SUPERUSER_EMAIL='admin@example.com'
SUPERUSER_PASSWORD='Secret@1'

OAUTH_GOOGLE_CLIENT_ID='test-google-client'
OAUTH_GOOGLE_CLIENT_SECRET='test-google-secret'
# GitHub OAuth app (github.com/settings/developers); callback: <BETTER_AUTH_URL>/auth/callback/github
OAUTH_GITHUB_CLIENT_ID='test-github-client'
OAUTH_GITHUB_CLIENT_SECRET='test-github-secret'

LOG_LEVEL='silent'

BASIC_AUTH_USER='admin'
BASIC_AUTH_PASS='Secret@1'

REDIS_HOST='localhost'
REDIS_PORT='6399'
REDIS_USER=''
REDIS_PASSWORD=''

# Never delivered — AppFactory replaces MailService with a no-op.
SMTP_HOST='smtp.example.com'
SMTP_PORT='465'
SMTP_SECURE='true'
SMTP_USER='test'
SMTP_PASSWORD='test'
SMTP_FROM='Qotm Api Test <no-reply@example.com>'
SMTP_SUPPORT_EMAIL='support@example.com'

S3_REGION='us-east-1'
S3_ENDPOINT=''
S3_BUCKET_NAME='qotm-api-test'
S3_ACCESS_KEY_ID=''
# RELEASES_BASE_URL: public URL of the bucket's releases/ prefix
# (https://releases.qotm.dev in production; defaults to the bucket's URL).
# RELEASES_BASE_URL=''
S3_SECRET_ACCESS_KEY=''
# The tests' share images and og:images live under test/, apart from development's.
S3_SHARE_PREFIX='test/'

# Off in tests so a shared window cannot leak between specs.
RATE_LIMIT_ENABLED='false'
RATE_LIMIT_TTL='60000'
RATE_LIMIT_MAX='120'
RATE_LIMIT_AUTH_WINDOW='10'
RATE_LIMIT_AUTH_MAX='100'
RATE_LIMIT_IP_HEADERS='x-forwarded-for'
