{
  "compilerOptions": {
		"jsx": "react",
    // node20 models require(esm): the app stays CommonJS while Nest 12 ships ESM.
    "module": "node20",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"moduleResolution": "node16",
    "target": "ES2021",
		"allowJs": true,
    "sourceMap": true,
    "outDir": "./dist",
		"strict": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": true,
		"resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
		"paths": {
			// Bare imports like `common/services` resolve from src/ (replaces baseUrl).
			"*": ["./src/*"],
			"@seeders/*": ["./seeders/*"],
			"@emails/*": ["./emails/*"],
			"@test/*": ["./test/*"],
		},
		"types": ["node"]
  },
}
