{
	"name": "@qotm/api",
	"version": "0.0.1",
	"description": "API service",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"start": "tsx .bin/start.ts",
		"dev": "tsx .bin/start.ts",
		"start:prod": "node dist/src/main",
		"build": "nest build",
		"gen": "nest generate",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" --no-error-on-unmatched-pattern",
		"email:dev": "email dev -p 5003",
		"secrets": "secrets",
		"db:generate": "yarn workspace @qotm/db build",
		"db:push": "tsx ./.bin/db.ts -c push",
		"db:migrate:create": "dotenv -e .env -- yarn workspace @qotm/db prisma migrate dev --create-only",
		"db:migrate": "dotenv -e .env -- yarn workspace @qotm/db prisma migrate dev \"$@\" && yarn db:generate",
		"db:migrate:prod": "yarn workspace @qotm/db prisma migrate deploy",
		"db:seed": "tsx ./.bin/db.ts -c seed",
		"db:reset": "tsx ./.bin/db.ts -c reset",
		"db:studio": "tsx ./.bin/db.ts -c studio",
		"test:db:generate": "yarn db:generate",
		"test:db:push": "tsx ./.bin/db.ts -c push -e test",
		"test:db:seed": "tsx ./.bin/db.ts -c seed -e test",
		"test": "dotenv -e .env.test -- vitest run --project unit",
		"test:watch": "dotenv -e .env.test -- vitest --project unit",
		"test:ui": "dotenv -e .env.test -- vitest --ui --project unit",
		"test:e2e": "dotenv -e .env.test -- vitest run --project e2e",
		"test:e2e:watch": "dotenv -e .env.test -- vitest --project e2e",
		"test:e2e:ui": "dotenv -e .env.test -- vitest --ui --project e2e",
		"test:cov": "dotenv -e .env.test -- vitest --coverage",
		"test:all": "dotenv -e .env.test -- vitest run",
		"test:all:ui": "dotenv -e .env.test -- vitest --ui",
		"dc:up": "tsx ./.bin/dc.ts -c up",
		"dc:down": "tsx ./.bin/dc.ts -c down",
		"dc:wait": "tsx ./.bin/dc.ts -c wait",
		"dc:recreate": "tsx ./.bin/dc.ts -c recreate",
		"dc:reinstall": "yarn dc:recreate && yarn db:generate && yarn db:migrate && yarn db:seed",
		"test:dc:up": "tsx ./.bin/dc.ts -c up -e test",
		"test:dc:wait": "tsx ./.bin/dc.ts -c wait -e test",
		"test:dc:down": "tsx ./.bin/dc.ts -c down -e test",
		"test:dc:recreate": "tsx ./.bin/dc.ts -c recreate -e test",
		"test:dc:reinstall": "yarn test:dc:recreate && yarn test:db:generate && yarn test:db:push && yarn test:db:seed",
		"down": "yarn dc:down && yarn test:dc:down",
		"reinstall": "yarn dc:reinstall && yarn test:dc:reinstall"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1013.0",
		"@bull-board/api": "^9.10.1",
		"@bull-board/express": "^9.10.1",
		"@bull-board/nestjs": "^9.10.1",
		"@faker-js/faker": "^8.0.2",
		"@nestjs-modules/mailer": "^2.3.7",
		"@nestjs/axios": "^12.0.1",
		"@nestjs/bullmq": "^12.0.0",
		"@nestjs/common": "^12.1.0",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.1.0",
		"@nestjs/platform-express": "^12.1.0",
		"@nestjs/schedule": "^12.0.2",
		"@nestjs/swagger": "^12.0.2",
		"@nestjs/terminus": "^12.1.0",
		"@nestjs/throttler": "^6.7.1",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.80.0",
		"@opentelemetry/core": "^2.11.0",
		"@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
		"@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
		"@opentelemetry/instrumentation": "^0.222.0",
		"@opentelemetry/instrumentation-express": "^0.70.0",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-logs": "^0.222.0",
		"@opentelemetry/sdk-metrics": "^2.11.0",
		"@opentelemetry/sdk-node": "^0.222.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"@paralleldrive/cuid2": "^3.3.0",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/instrumentation": "^7.10.0",
		"@qotm/db": "workspace:*",
		"@react-email/components": "^0.0.7",
		"@react-email/render": "^0.0.7",
		"@scalar/nestjs-api-reference": "^1.2.22",
		"@thallesp/nestjs-better-auth": "^2.8.0",
		"axios": "^1.4.0",
		"better-auth": "^1.7.6",
		"bullmq": "^6.3.9",
		"bullmq-otel": "^2.0.1",
		"express": "^5.2.1",
		"express-basic-auth": "^1.2.1",
		"helmet": "^7.0.0",
		"import-in-the-middle": "^3.5.1",
		"ioredis": "^5.4.1",
		"moment": "^2.29.4",
		"nestjs-pino": "^5.2.0",
		"nodemailer": "^8.0.11",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"randomstring": "^1.3.0",
		"react": "^18.2.0",
		"react-email": "^1.9.4",
		"reflect-metadata": "^0.1.13",
		"rxjs": "^7.8.1",
		"shelljs": "^0.10.0",
		"uuid": "^13.0.0",
		"yargs": "^18.0.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@aurostack/secrets": "^0.1.1",
		"@eslint/js": "^10.0.1",
		"@golevelup/ts-vitest": "^2.2.0",
		"@nestjs/cli": "^12.0.6",
		"@nestjs/schematics": "^12.0.5",
		"@nestjs/testing": "^12.1.0",
		"@suites/di.nestjs": "^3.0.1",
		"@suites/doubles.vitest": "^3.0.1",
		"@suites/unit": "^3.0.1",
		"@swc/core": "^1.15.18",
		"@types/express": "^5.0.6",
		"@types/multer": "^1.4.7",
		"@types/node": "^25.0.9",
		"@types/nodemailer": "^8.0.2",
		"@types/randomstring": "^1.1.8",
		"@types/react": "^18.2.14",
		"@types/shelljs": "^0.10.0",
		"@types/supertest": "^2.0.12",
		"@types/yargs": "^17.0.35",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/ui": "^4.1.11",
		"cross-env": "^7.0.3",
		"dotenv": "^17.4.2",
		"dotenv-cli": "^7.2.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"fishery": "^2.2.2",
		"globals": "^17.12.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.9",
		"source-map-support": "^0.5.21",
		"supertest": "^6.3.3",
		"ts-loader": "^9.4.3",
		"tsx": "^4.22.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1",
		"unplugin-swc": "^1.5.9",
		"vitest": "^4.1.11"
	},
	"installConfig": {
		"hoistingLimits": "workspaces"
	}
}
