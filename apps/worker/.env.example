# Copy to .env.

APP_ENV='development'
LOG_LEVEL='debug'

# The same database your API uses — this worker talks to it directly rather
# than over HTTP, so the schema must match.
DATABASE_URL='postgresql://root:postgres@localhost:5432/main'

# The same Redis your API produces jobs to. A mismatch here is silent: the
# worker connects fine and simply never receives anything.
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_USER=''
REDIS_PASSWORD=''

# OpenTelemetry → OpenObserve: traces, logs and metrics. Leave empty and
# telemetry stays off. Per project: OPENOBSERVE_ORG is the organization
# identifier, OPENOBSERVE_TOKEN its ingestion token (IAM → Ingestion Tokens).
# Any other OTLP backend: set OTEL_EXPORTER_OTLP_ENDPOINT/HEADERS instead.
OPENOBSERVE_URL='https://o2.aurostack.co'
OPENOBSERVE_ORG=''
OPENOBSERVE_TOKEN=''
OTEL_SERVICE_NAME='qotm-worker'

# Unset = use Puppeteer's bundled Chromium. Set it only to a real path, for a
# Chromium installed separately. Never set it empty in a deployed env: the
# worker image sets /usr/bin/chromium-browser, an empty value replaces that,
# and Puppeteer then fails looking for a bundled Chrome the image never downloads.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# S3-compatible storage: the same bucket the API's media client uses.
S3_ENDPOINT=''
S3_REGION='us-east-1'
S3_BUCKET_NAME=''
S3_ACCESS_KEY_ID=''
S3_SECRET_ACCESS_KEY=''

# Dataset releases: key prefix in the bucket, and the public URL serving it
# (https://releases.qotm.dev in production; defaults to the bucket's own URL).
# RELEASES_PREFIX='releases'
# RELEASES_BASE_URL='https://releases.qotm.dev'
