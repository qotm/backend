{
	"name": "@qotm/worker",
	"version": "1.0.0",
	"type": "module",
	"main": "dist/src/index.js",
	"license": "MIT",
	"imports": {
		"#app/*": {
			"development": "./src/*",
			"default": "./dist/src/*"
		},
		"#utils/*": {
			"development": "./src/utils/*",
			"default": "./dist/src/utils/*"
		},
		"#lib/*": {
			"development": "./src/lib/*",
			"default": "./dist/src/lib/*"
		}
	},
	"scripts": {
		"dev": "tsx --conditions=development --import ./src/instrumentation.ts src/index.ts",
		"dev:watch": "tsx watch --conditions=development --import ./src/instrumentation.ts src/index.ts",
		"dataset:sample": "tsx --conditions=development src/dataset/sample.ts",
		"build": "tsc",
		"start": "node --import ./dist/src/instrumentation.js dist/src/index.js",
		"secrets": "secrets",
		"db:generate": "yarn workspace @qotm/db build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.80.0",
		"@opentelemetry/core": "^2.11.0",
		"@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
		"@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
		"@opentelemetry/instrumentation": "^0.222.0",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-logs": "^0.222.0",
		"@opentelemetry/sdk-metrics": "^2.11.0",
		"@opentelemetry/sdk-node": "^0.222.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"@paralleldrive/cuid2": "^3.3.0",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/instrumentation": "^7.10.0",
		"@qotm/db": "workspace:*",
		"bullmq": "^6.3.9",
		"bullmq-otel": "^2.0.1",
		"dotenv": "^17.4.2",
		"import-in-the-middle": "^3.5.1",
		"ioredis": "^5.4.1",
		"moment": "^2.30.1",
		"pino": "^10.3.1",
		"puppeteer": "^25.3.0",
		"shelljs": "^0.10.0",
		"yargs": "^18.0.0"
	},
	"devDependencies": {
		"@aurostack/secrets": "^0.1.1",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.0",
		"@types/shelljs": "^0.10.0",
		"@types/yargs": "^17.0.35",
		"dotenv-cli": "^7.2.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.7.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.4",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1",
		"vitest": "^4.1.11"
	}
}
